# Copy to .env and fill in. Compose reads .env automatically; .env is gitignored.
# Never commit real values.

# Database name inside the containerised mongo. MONGO_URL is set by compose to
# the service address, so it does not belong here.
DB_NAME=hianzy

# Origin the browser loads the site from. This is what CORS must allow, and
# what the sitemap advertises. Change both if you publish on another port.
SITE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Where the browser should call the API. Baked into the bundle at build time,
# so a change here needs `docker compose build web`.
REACT_APP_BACKEND_URL=http://localhost:8010

# Origins the page may call, appended to the CSP's connect-src. Defaults to
# REACT_APP_BACKEND_URL, which is right for most setups. Set it only if the
# browser has to reach an origin the bundle was not told about — and note the
# browser blocks anything not listed, without a visible error on the page.
CSP_CONNECT_SRC=

# development keeps /docs open and the localhost CORS allowlist active.
# Set to production before exposing this anywhere.
ENVIRONMENT=development

# Session cookie. secure=true needs HTTPS. samesite=none is what lets the
# cookie travel when the API is on a different origin from the site, and
# browsers only honour none alongside secure=true — so set both together.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated addresses allowed to read contact submissions and the
# subscriber list. Unset means nobody can, which is the safe default.
ADMIN_EMAILS=

# Outbound notification for contact and subscribe. Resend is tried first and
# SMTP is the fallback. Leave all of it blank and submissions are still
# stored, just not emailed.
RESEND_API_KEY=
RESEND_FROM=
CONTACT_NOTIFY_EMAIL=anish@hianzy.com

# SMTP fallback, used only when RESEND_API_KEY is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# hiAnzy — backend configuration
# Copy to .env and fill in. Never commit the real .env.

# ── Database (required) ──────────────────────────────────────────────────────
MONGO_URL=
DB_NAME=

# ── Environment ──────────────────────────────────────────────────────────────
# Anything other than development/dev/local is treated as production, which
# disables /docs, /redoc and /openapi.json and enables HSTS.
ENVIRONMENT=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Explicit comma-separated origins, e.g. https://hianzy.com,https://www.hianzy.com
# A wildcard is REFUSED here: credentials are enabled, and echoing an arbitrary
# origin would let any site ride a signed-in visitor's session cookie.
CORS_ORIGINS=

# ── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated addresses permitted to read contact submissions (PII).
# Leave empty and that endpoint refuses everyone.
ADMIN_EMAILS=

# ── Session cookie ───────────────────────────────────────────────────────────
# Production: COOKIE_SECURE=true and COOKIE_SAMESITE=none (requires HTTPS).
# Local http dev: false / lax, because SameSite=None needs Secure.
COOKIE_SECURE=
COOKIE_SAMESITE=

# ── Contact notifications (optional) ─────────────────────────────────────────
# Submissions are always stored; email is skipped when unconfigured.
# Either Resend…
RESEND_API_KEY=
RESEND_FROM=
# …or SMTP.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Where notifications are delivered.
CONTACT_NOTIFY_EMAIL=anish@hianzy.com

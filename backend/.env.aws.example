# AWS App Runner — production environment variables
# Set every variable below in the App Runner service via AWS Console or CLI.
# Store secrets (MONGO_URL, RESEND_API_KEY) in AWS Secrets Manager and
# inject them as environment variables in the App Runner service definition.
# Never commit real values to this file.
#
# Differences from backend/.env.example (local/Docker dev defaults):
#   MONGO_URL          — Atlas production URI from Secrets Manager
#   ENVIRONMENT        — "production" (disables /docs, /redoc, /openapi.json; enables HSTS)
#   CORS_ORIGINS       — explicit production origins (app and API are on different subdomains)
#   COOKIE_SECURE      — true (HTTPS everywhere in production)
#   COOKIE_SAMESITE    — none (required for cross-subdomain cookie delivery:
#                        hianzy.com → api.hianzy.com)
#   PUBLIC_API_URL     — https://api.hianzy.com (the App Runner custom domain)

# --- DATABASE (required; hard failure if unset) ---
MONGO_URL=<from AWS Secrets Manager: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/>
DB_NAME=hianzy

# --- RUNTIME ---
ENVIRONMENT=production

# --- CORS ---
# Both root domain and www must be listed.
# If CORS_ORIGINS is empty the backend logs an error and denies all cross-origin requests.
CORS_ORIGINS=https://hianzy.com,https://www.hianzy.com

# --- COOKIE SECURITY ---
# none + Secure is required for cookies sent from hianzy.com to api.hianzy.com.
# SameSite=none without Secure=true raises a ValueError at import time.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# --- EMAIL (optional, but contact form silently no-ops without one configured) ---
# Preferred: Resend
RESEND_API_KEY=<from AWS Secrets Manager>
RESEND_FROM=hello@hianzy.com
# Fallback: SMTP (only used if RESEND_API_KEY is absent or empty)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=<from AWS Secrets Manager>

# --- NOTIFICATIONS ---
CONTACT_NOTIFY_EMAIL=anish@hianzy.com
ADMIN_EMAILS=anish@hianzy.com

# --- URLS ---
SITE_URL=https://hianzy.com
PUBLIC_API_URL=https://api.hianzy.com

# --- AUTH (post-launch, depends on auth product decision) ---
# AUTH_SESSION_DATA_URL=

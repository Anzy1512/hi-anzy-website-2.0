# AWS App Runner — production environment variables (docs/ADR-002)
# Set every variable below in the App Runner service configuration (Console or
# CLI). Store secrets (MONGO_URL, RESEND_API_KEY, SMTP_PASS if used) in AWS
# Secrets Manager and reference them from the service as runtime secrets; the
# service's instance role needs secretsmanager:GetSecretValue on exactly those
# secrets. Never commit real values to this file.
#
# Differences from backend/.env.example (local/Docker dev defaults):
#   MONGO_URL          — Atlas production URI, injected from Secrets Manager
#   ENVIRONMENT        — "production" (disables /docs, /redoc, /openapi.json; enables HSTS)
#   CORS_ORIGINS       — explicit production origins (site and API are on different origins)
#   COOKIE_SECURE      — true (HTTPS everywhere in production)
#   COOKIE_SAMESITE    — none while site and API are on different sites (see below)
#   PUBLIC_API_URL     — the API's own public origin (see below)
#
# Do NOT set VERCEL here. server.py gates IS_SERVERLESS on that variable; on
# App Runner it must stay unset so startup seeding, the rate-limit pruner and
# the notification retry loop run (docs/ADR-002, "Serverless gate").
#
# The frontend's build-time variables (REACT_APP_BACKEND_URL, SITE_URL) belong
# to the Amplify app, not to this service — see amplify.yml.

# --- DATABASE (required; hard failure if unset) ---
MONGO_URL=<runtime secret from Secrets Manager hianzy/prod/MONGO_URL — the Atlas SRV URI; never paste it here>
DB_NAME=hianzy

# --- RUNTIME ---
ENVIRONMENT=production

# --- PROXY ---
# App Runner's request router is the socket peer for every request and
# appends the visitor's address as the LAST x-forwarded-for hop. With this
# set, client_ip() (rate limiting) reads that hop and ignores anything a
# caller put in front of it. Leave unset on Docker/local, where the socket
# peer is the visitor; never set it on a host that is not behind App Runner.
TRUSTED_PROXY=apprunner

# --- CORS ---
# Both root domain and www must be listed. A wildcard is refused by server.py.
# If CORS_ORIGINS is empty the backend logs an error and denies all cross-origin requests.
# During the pre-cutover smoke test the Amplify default origin
# (https://main.<app-id>.amplifyapp.com) is appended temporarily and removed
# once hianzy.com is attached (docs/ADR-002, cutover order).
CORS_ORIGINS=https://hianzy.com,https://www.hianzy.com

# --- COOKIE SECURITY ---
# SameSite=none without Secure=true raises at import time (server.py refuses to start).
# none is required only while the site and the API are on different sites
# (*.amplifyapp.com → api.hianzy.com during the smoke test). hianzy.com and
# api.hianzy.com are the same site, so lax also works after cutover; keep none
# until the sign-in decision (P2) settles which is wanted.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# --- EMAIL (optional, but contact form silently no-ops without one configured) ---
# Preferred: Resend
RESEND_API_KEY=<runtime secret from Secrets Manager hianzy/prod/RESEND_API_KEY>
RESEND_FROM=hello@hianzy.com
# Fallback: SMTP (only used if RESEND_API_KEY is absent or empty)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=<runtime secret from Secrets Manager hianzy/prod/SMTP_PASS>

# --- NOTIFICATIONS ---
CONTACT_NOTIFY_EMAIL=anish@hianzy.com
ADMIN_EMAILS=anish@hianzy.com

# --- URLS ---
# SITE_URL is the public website origin. PUBLIC_API_URL is the API's own public
# origin: newsletter confirmation and unsubscribe links are /api/newsletter/...
# on the API, so it must not be the site origin here. Until api.hianzy.com is
# attached this is the service's default https://<service-id>.<region>.awsapprunner.com.
SITE_URL=https://hianzy.com
PUBLIC_API_URL=https://api.hianzy.com

# --- AUTH (post-launch, depends on auth product decision) ---
# AUTH_SESSION_DATA_URL=

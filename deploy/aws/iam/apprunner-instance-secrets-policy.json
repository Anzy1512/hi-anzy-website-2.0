{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyTheTwoRuntimeSecretsOfThisEnvironment",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:hianzy/<ENVIRONMENT>/MONGO_URL-*",
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:hianzy/<ENVIRONMENT>/RESEND_API_KEY-*"
      ]
    }
  ]
}

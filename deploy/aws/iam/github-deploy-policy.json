{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLoginTokenIsAccountWide",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushAndReadTheApiRepositoryOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeImages",
        "ecr:DescribeRepositories"
      ],
      "Resource": "arn:aws:ecr:<REGION>:<ACCOUNT_ID>:repository/hianzy-api"
    },
    {
      "Sid": "UpdateTheTwoApiServicesOnly",
      "Effect": "Allow",
      "Action": [
        "apprunner:DescribeService",
        "apprunner:UpdateService",
        "apprunner:ListOperations",
        "apprunner:StartDeployment"
      ],
      "Resource": [
        "arn:aws:apprunner:<REGION>:<ACCOUNT_ID>:service/hianzy-api-staging/*",
        "arn:aws:apprunner:<REGION>:<ACCOUNT_ID>:service/hianzy-api-prod/*"
      ]
    },
    {
      "Sid": "PassOnlyTheEcrAccessRoleAndOnlyToAppRunner",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/AppRunnerECRAccessRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "apprunner.amazonaws.com"
        }
      }
    }
  ]
}
